# Scrapi v2.0 Production Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Storage & Output Directory (optional, defaults to ./data and ./output)
# SCRAPI_DATA_DIR=./data
# SCRAPI_OUTPUT_DIR=./output

# Optional: LLM Integration (for smart auto-extraction)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3
